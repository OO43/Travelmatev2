{
  "expo": {
    "name": "TravelMate Main 2.0",
    "slug": "travelmate-main-2-0",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/TravelmateIcon.png",
    "userInterfaceStyle": "light",
    "scheme": "travelmate",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TravelMate to scan tickets and travel barcodes."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.greene4ev.travelmate"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/TravelmateIcon.png",
        "backgroundImage": "./assets/TravelmateIcon.png",
        "monochromeImage": "./assets/TravelmateIcon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.greene4ev.travelmate"
    },
    "web": {
      "favicon": "./assets/TravelmateIcon.png"
    }
  }
}
